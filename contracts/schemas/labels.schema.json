{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsc.local/contracts/labels.schema.json",
  "title": "LabelMap",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "labels"],
  "properties": {
    "schema_version": { "type": "string" },
    "labels": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class_id", "code", "display_text", "raw_label"],
        "properties": {
          "class_id": { "type": "integer", "minimum": 0, "maximum": 9 },
          "code": { "type": "string" },
          "display_text": { "type": "string" },
          "raw_label": { "type": "string" }
        }
      }
    }
  }
}
