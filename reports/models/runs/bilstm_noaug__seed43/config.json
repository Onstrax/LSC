{
  "name": "bilstm_noaug",
  "seed": 43,
  "model": "bilstm",
  "augment": false,
  "model_params": {
    "proj_dim": 64,
    "units": 64,
    "dropout": 0.3
  },
  "training": {
    "optimizer": "adam",
    "learning_rate": 0.001,
    "batch_size": 32,
    "max_epochs": 80,
    "patience": 12,
    "min_epochs": 5,
    "monitor": "val_macro_f1",
    "restore_best": true
  },
  "augmentation": {
    "policy": "train_v1"
  },
  "latency": {
    "warmup": 20,
    "repeats": 200
  }
}
